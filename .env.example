# Copy to .env.local (never commit .env.local).
# Only NEXT_PUBLIC_* values are visible in the browser; restart `npm run dev` after changing them.
# NEXT_PUBLIC_* values are baked in at BUILD time: on Vercel, set them in the project settings and redeploy.

# Where the DevShelf API runs (repo devshelf-api). Local default below; the deployed site uses the Render URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Playwright: which server to test. Unset = Playwright starts the local dev server itself.
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Playwright: where the API is, for the health check before the run and the tests that read it directly.
# E2E_API_URL=http://localhost:8080
